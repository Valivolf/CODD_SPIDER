# Скопируйте этот файл в .env и настройте перед первым запуском.

APP_NAME=Календарь работ

# Порт и хост НЕ настраиваются здесь — сервер всегда слушает 0.0.0.0:8000
# (см. docker/Dockerfile, docker/docker-compose.yml, scripts/Запустить.bat).
# Чтобы сменить порт, отредактируйте все три файла одинаково.
#
# В Docker-варианте порт 8000 приложения привязан только к 127.0.0.1 на хосте
# (не виден в локальной сети) — единственная точка входа снаружи это caddy
# (порты 80/443, в host-сети, чтобы видеть реальный IP хоста). См. docker/Caddyfile.

# Автоматически определяется и перезаписывается сюда caddy при КАЖДОМ старте
# контейнера (см. docker/caddy-entrypoint.sh) — берётся IPv4-адрес интерфейса
# NETWORK_INTERFACE ниже. Менять руками не нужно; можно оставить пустым при
# первом запуске. Именно на этот адрес выписывается самоподписанный
# HTTPS-сертификат, и именно по нему заходят в браузере: https://<адрес>.
# localhost и 127.0.0.1 добавляются caddy автоматически сверху.
SERVER_ADDRESS=

# Сетевой интерфейс хоста, с которого брать IP для SERVER_ADDRESS выше —
# например, ens33 (типичное имя для VMware/Ubuntu), eth0, enp0s3. Посмотреть
# своё: `ip -4 addr` на хосте. Работает только в Docker-варианте с caddy
# (требует network_mode: host, см. docker-compose.yml — Linux-only).
NETWORK_INTERFACE=ens33

# Учётная запись администратора, создаваемая автоматически при первом запуске
# (только если в базе ещё нет ни одного пользователя). Сразу после первого
# входа система попросит сменить этот пароль.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Ключ для подписи сессионных JWT-токенов. Если оставить пустым, ключ будет
# сгенерирован автоматически и сохранён в data/.secret_key — можно не задавать
# вручную, но тогда не переносите папку data между окружениями без нужды.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Ключ шифрования ФИО и телефонов персонала, логинов и паролей комплексов в базе (AES-256). Пусто — ключ создаётся сам при первом запуске и лежит
# в data/.field_key (Настройки → «🔑 Ключ шифрования» покажет его для резервной копии). Хотите хранить ключ отдельно от папки данных — вставьте сюда
# (43 знака, получить: «Настройки → Ключ шифрования → Показать ключ»). Без ключа зашифрованное не прочитать — копия базы без него бесполезна.
FIELD_ENCRYPTION_KEY=

# true — если сервис работает за HTTPS-прокси (тогда cookie сессии будет
# отправляться только по защищённому соединению).
# - Docker-вариант (docker compose, с caddy из docker/Caddyfile) — поставьте true.
# - Прямой запуск без Docker по обычному http:// (scripts/Запустить.bat) — оставьте false,
#   иначе браузер не станет отправлять cookie на незащищённом соединении и вход не будет работать.
COOKIE_SECURE=false

BACKUP_RETENTION=30
# Сколько секунд перепроверять работавший комплекс, который перестал отвечать, прежде чем считать его неработающим
# (связь могла пропасть на мгновение). 0 — менять статус сразу, без ожидания.
# POINT_DOWN_GRACE_SECONDS=120

# Бланк печатного «План-задание» (см. кнопку «Excel → План-наряд (бланк)»).
# Необязательно — не заданы, строки на бланке останутся пустыми для заполнения от руки.
PLAN_ORG_TITLE=
PLAN_APPROVER_NAME=
PLAN_ROUTE_LABEL=
PLAN_SAFETY_OFFICER=

# Фото выездов на сетевом диске (чтобы не занимать диск сервера). Сначала подключите диск на сервере в
# /mnt/lan-calendar-photos (см. инструкцию), затем раскомментируйте PHOTOS_DIR, перезапустите приложение и в окне
# «Фото по дням» (мониторинг) нажмите «Подготовить диск». Не задано — фото лежат на диске сервера, как раньше.
# PHOTOS_DIR=/app/photos
# Как диск называется для людей (только подпись в окне «Фото по дням»):
# PHOTOS_SHARE_LABEL=\\NAS\фото

# ---- Безопасность (подробности — комплект документов в docs/compliance) ----
# Минимальная длина пароля пользователя (не меньше 6; рекомендуется 8–12). Всегда нужны буквы и цифры; пароль не должен содержать логин.
# PASSWORD_MIN_LENGTH=8
# Автоматический выход из системы после N минут без действий пользователя (0 — выключено). Рекомендуется 30–60 для рабочих мест; для «дежурных» экранов
# (мониторинг, уведомления) оставьте 0 или заведите отдельную учётную запись.
# SESSION_IDLE_MINUTES=0
# Сколько дней хранить журнал событий безопасности в базе (не меньше 30; по умолчанию 365). Те же события пишутся строками SECEVENT в журнал контейнера (docker logs).
# SECURITY_LOG_RETENTION_DAYS=365
# Защита от подделки запросов с чужих сайтов: запрос на изменение, у которого браузер указал чужой адрес страницы (заголовок Origin), отклоняется. Если систему открывают через
# промежуточный прокси, подменяющий адрес, перечислите разрешённые адреса страниц через запятую (например, https://calendar.example.local); выключить проверку — ORIGIN_CHECK=false.
# TRUSTED_ORIGINS=
# ORIGIN_CHECK=true
